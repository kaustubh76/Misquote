# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# node
node_modules/
.next/
out/

# foundry
vetting/forge/out/
vetting/forge/cache/
vetting/forge/lib/

# secrets — a raw key must never reach the repo
.env
.env.*
!.env.example
*.keystore
keystore/

# local state
data/*.db
data/*.db-wal
data/*.db-shm
data/cache/

# ops
ops/KILL

.DS_Store

# # Needs a browser: `cd apps/web && pnpm exec playwright install chromium`.
# This is the only check that runs real layout, and it earns its keep — the
# whole suite was green while every route but "/" fetched its artifacts from
# a page-relative path and rendered an error state.
# `NEXT_DIST_DIR` keeps this build out of `.next`, which `make web` is
# serving from. Sharing it meant every web-check killed the running dev
# server with `Cannot find module './393.js'` — the build swaps the chunks
# out from under it — and the fix looked like a broken app rather than two
# commands writing to one directory.
cd apps/web && NEXT_DIST_DIR=.next-check pnpm build

