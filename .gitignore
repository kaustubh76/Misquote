# python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# node
node_modules/
.next/
# `make web-check` builds here instead of `.next` so it does not swap
# chunks out from under a running `make web`.
.next-check/
out/

# foundry
vetting/forge/out/
vetting/forge/cache/
vetting/forge/lib/

# secrets — a raw key must never reach the repo
.env
.env.*
!.env.example
*.keystore
keystore/

# local state
data/*.db
data/*.db-wal
data/*.db-shm
data/cache/

# The deployed tape slice is committed — `data/*.db` above matches direct
# children only, so it is tracked without a negation. Its WAL sidecars are not:
# anything that opens it read-write leaves them, including `make api` and the
# suite.
data/deploy/*.db-wal
data/deploy/*.db-shm

# ops
ops/KILL

.DS_Store

# Scratch files. Several one-off screenshot and probe scripts have been
# committed by accident from apps/web/scripts/ during UI work.
_*.mjs

# TypeScript incremental build cache. Tracked for months and churning in every
# diff before anyone noticed.
apps/web/tsconfig.tsbuildinfo

# Vercel CLI link state.
.vercel/
