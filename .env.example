# Copy to .env and fill in. .env is gitignored — a raw private key must never
# reach the repo, and ideally never reaches this file either (see WALLET_*).

# --- chain -----------------------------------------------------------------
BSC_RPC_URL=                    # mainnet (56). A keyed endpoint; public ones rate-limit backfills.
BSC_TESTNET_RPC_URL=            # chapel (97)
BSC_FORK_RPC_URL=               # what anvil forks from; defaults to BSC_RPC_URL

# --- wallet ----------------------------------------------------------------
# Preferred: an encrypted keystore file, unlocked at process start.
WALLET_KEYSTORE_PATH=
# Escape hatch for testnet only. The signer refuses to use this when chainId==56.
WARDEN_PRIVATE_KEY=

# --- target pool -----------------------------------------------------------
TARGET_POOL=                    # Pancake v3 WBNB/USDT 0.05% — filled in at Step 3, verified by eth_call
TARGET_CHAIN_ID=56

# --- signals ---------------------------------------------------------------
# Toxicity CEX leg. Unset => the on-chain fallback rule (spec §3.4) is used and labeled.
CEX_FEED_URL=wss://stream.binance.com:9443/ws/bnbusdt@bookTicker

# --- storage ---------------------------------------------------------------
DB_PATH=./data/misquote.db

# --- operations ------------------------------------------------------------
MISQUOTE_DRY_RUN=1              # 1 = read chain, never sign. Flipping this to 0 is a deliberate act.
MISQUOTE_POSITION_CAP_USD=      # set at the Step 15 go/no-go, not before
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
PROMETHEUS_PORT=9100

# --- marketplace rails (Step 17) -------------------------------------------
ALTANA_API_KEY=
ALTANA_SESSION_CONFIG=
