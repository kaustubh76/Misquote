# Copy to .env and fill in. .env is gitignored.
#
# Every name below is one the code actually reads — checked, not assumed. The
# previous version of this file had drifted: it asked for `WARDEN_PRIVATE_KEY`
# and `MISQUOTE_POSITION_CAP_USD`, which nothing reads, while omitting
# `MISQUOTE_PRIVATE_KEY` and `MISQUOTE_POSITION_CAP_QUOTE`, which the signer and
# the go/no-go do. Filling that version in correctly still produced a config
# that did nothing, silently.
#
# Nothing here is required to run `make test`, `make advantage-demo`, `make vet`,
# `make warden` or `make indexer-follow`. All of those work on public endpoints
# today. What these unlock is history, and eventually signing.


# ─────────────────────────────────────────────────────────────────────────────
# 1. THE ONE THAT MATTERS — a keyed mainnet RPC
# ─────────────────────────────────────────────────────────────────────────────
# Most public BSC endpoints do not serve `eth_getLogs` at all. Surveyed 16 Aug
# 2026: of 22, every bnbchain dataseed, both defibit hosts and ninicoin answer
# `eth_chainId` with 56 in milliseconds and refuse every log query with
# `-32005`, including a one-block one. Three serve logs, each capped at 5,000
# blocks a request.
#
# So a live tail works today without this (`make indexer-follow`) — it needs one
# request per 5,000 blocks of chain, which is roughly one every 37 minutes of
# real time. A 30-day backfill is 1,152 requests at that width, and that is
# where a key earns its place.
#
# This unblocks, in order: the 30-day tape -> the fitted kappa (gap item G-4)
# -> the cards saying `source: chain` instead of `source: synthetic` -> the
# TermiX track's "three **real** tasks" requirement, which is the one worth
# $10,000 and is currently amber for exactly this reason.
#
# Free tiers that are enough: NodeReal MegaNode, QuickNode, Ankr, Chainstack,
# BlockPI, dRPC. Any of them. It needs no funds and no wallet — it is a read key.
BSC_RPC_URL=

# Chapel (97). Only needed for a testnet burn-in.
BSC_TESTNET_RPC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 2. ARCHIVE RPC — optional, improves reproducibility
# ─────────────────────────────────────────────────────────────────────────────
# `make fork-diff` compares our position math against the real
# NonfungiblePositionManager on an anvil fork. With an archive endpoint the fork
# pins a block and the comparison is reproducible; without one it falls back to
# near-head and says so in the output. No free BSC endpoint serves archive state.
BSC_ARCHIVE_RPC_URL=

# What anvil forks from. Defaults to BSC_ARCHIVE_RPC_URL, then BSC_RPC_URL.
BSC_FORK_RPC_URL=

# ─────────────────────────────────────────────────────────────────────────────
# 3. WALLET — testnet only, and not yet useful
# ─────────────────────────────────────────────────────────────────────────────
# Read this before generating anything: **there is no chain executor in this
# repository.** `agents/warden/live.py` defines the `Executor` protocol and one
# implementation, `SimulatedExecutor`, which moves a position in memory. So a
# funded wallet cannot yet cause a transaction, because the code that would
# build one has not been written. It is on the not-built ledger.
#
# When it exists it will be built and tested against an anvil fork first, using
# anvil's own funded accounts — which needs nothing from you.
#
# So supply this only when a real testnet burn-in is the next step.
#
#   - A DEDICATED wallet, generated for this and used for nothing else.
#   - Never a wallet holding anything you would mind losing entirely.
#   - Testnet BNB from https://testnet.bnbchain.org/faucet-smart
#
# The signer refuses to broadcast unless MISQUOTE_DRY_RUN is explicitly "0".
MISQUOTE_PRIVATE_KEY=

# 1 (or unset) = read the chain, never sign. The default, and a missing config
# therefore refuses to trade rather than trading. Setting this to 0 is a
# deliberate act and the go/no-go reports it.
MISQUOTE_DRY_RUN=1

# The most capital a position may hold, in the pool's token1. The go/no-go FAILS
# when this is unset under --mainnet: the plan says it is chosen at that gate,
# deliberately, and never defaulted.
MISQUOTE_POSITION_CAP_QUOTE=

# ─────────────────────────────────────────────────────────────────────────────
# 4. OPTIONAL
# ─────────────────────────────────────────────────────────────────────────────
# Toxicity's CEX leg. Unset means the on-chain fallback of spec section 3.4
# applies, and every card says which rule it used. The live run so far has been
# on the fallback: "the CEX price feed was unavailable on 99% of samples".
CEX_FEED_URL=wss://stream.binance.com:9443/ws/bnbusdt@bookTicker

DB_PATH=./data/misquote.db
MISQUOTE_JOURNAL_DIR=./data/journal

# Pool and chain. Both default to the verified target pool; override to point the
# indexer or the badge somewhere else.
TARGET_POOL=
TARGET_CHAIN_ID=56

# ─────────────────────────────────────────────────────────────────────────────
# NOT WIRED TO ANYTHING — listed so their absence is not mistaken for an omission
# ─────────────────────────────────────────────────────────────────────────────
# ALTANA_API_KEY / ALTANA_SESSION_CONFIG — sessions/ is a docstring, on the ledger
# TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_IDS — ops/ is a docstring, on the ledger
# PROMETHEUS_PORT                        — same
# WALLET_KEYSTORE_PATH                   — keystore unlocking is not implemented;
#                                          the signer reads MISQUOTE_PRIVATE_KEY
