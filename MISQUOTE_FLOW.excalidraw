   "versionNonce": 1574357296,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Clear for m_clear = 10 consecutive samples, and under the day's budget of 8. Without\nthat budget the agent pulled and returned 2,585 times on a 30-day tape (P-12).\nDeliberately asymmetric: it gates coming back, never leaving, because an agent\nforbidden to exit is held inside the flow the rule exists to escape.",
   "originalText": "Clear for m_clear = 10 consecutive samples, and under the day's budget of 8. Without\nthat budget the agent pulled and returned 2,585 times on a 30-day tape (P-12).\nDeliberately asymmetric: it gates coming back, never leaving, because an agent\nforbidden to exit is held inside the flow the rule exists to escape.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
