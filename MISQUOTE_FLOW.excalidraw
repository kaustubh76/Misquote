   "text": "packages/misquote/agents/router/ \u2014 no studio.py",
   "originalText": "packages/misquote/agents/router/ \u2014 no studio.py",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
