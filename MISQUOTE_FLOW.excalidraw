   "text": "Three load-bearing schema decisions",
   "originalText": "Three load-bearing schema decisions",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0256",
   "type": "text",
   "x": 2544,
   "y": 2831.5,
   "width": 118.8,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
