  },
  {
   "id": "mq0545",
   "type": "text",
   "x": 3930,
   "y": 5750.75,
   "width": 1210.56,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0541"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1588705169,
   "version": 1,
   "versionNonce": 1588705169,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "The state the forked workers inherit lives in a module-level dict, so a second concurrent call would overwrite the spans and policy the first is replaying against and return a plausible quote of\nthe wrong thing. It raises instead.",
   "originalText": "The state the forked workers inherit lives in a module-level dict, so a second concurrent call would overwrite the spans and policy the first is replaying against and return a plausible quote of\nthe wrong thing. It raises instead.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
