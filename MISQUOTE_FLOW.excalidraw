   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "How to read this band",
   "originalText": "How to read this band",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0182",
   "type": "text",
   "x": 2284,
   "y": 1541.0,
   "width": 1385.28,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0179"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1550688542,
   "version": 1,
   "versionNonce": 1550688542,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Top to bottom is one turn of the loop, not a pipeline. A driver (layer 3) pulls a window of events off layer 1, hands it down to layer 2, and gets a Decision back \u2014 which is why the engine sits *below* the things that call\nit. Follow the left column for a replay and the right one for the live agent; they meet in the middle, and that meeting is the product claim.",
   "originalText": "Top to bottom is one turn of the loop, not a pipeline. A driver (layer 3) pulls a window of events off layer 1, hands it down to layer 2, and gets a Decision back \u2014 which is why the engine sits *below* the things that call\nit. Follow the left column for a replay and the right one for the live agent; they meet in the middle, and that meeting is the product claim.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0183",
   "type": "text",
   "x": 2284,
   "y": 1577.0,
   "width": 396.0,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0179"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1550793271,
   "version": 1,
   "versionNonce": 1550793271,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "the two lanes share exactly one implementation of the policy",
   "originalText": "the two lanes share exactly one implementation of the policy",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
