   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Why a range and not a number",
   "originalText": "Why a range and not a number",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0535",
   "type": "text",
   "x": 2730,
   "y": 5733.0,
   "width": 1141.92,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0532"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1587657879,
   "version": 1,
   "versionNonce": 1587657879,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Two sources of spread, both required by A5. Sampling spread: a strategy that earned well in one fortnight and badly in the next has a wide band, and that width is the honest statement\nabout how much the headline depends on when you started. Parameter spread: gamma is a user preference and kappa is a fitted parameter whose functional form is a documented\napproximation, so both are wiggled a quarter. A quote that collapses under that was never a quote.",
   "originalText": "Two sources of spread, both required by A5. Sampling spread: a strategy that earned well in one fortnight and badly in the next has a wide band, and that width is the honest statement\nabout how much the headline depends on when you started. Parameter spread: gamma is a user preference and kappa is a fitted parameter whose functional form is a documented\napproximation, so both are wiggled a quarter. A quote that collapses under that was never a quote.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0536",
   "type": "text",
   "x": 2730,
   "y": 5784.0,
   "width": 349.8,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0532"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1587762608,
   "version": 1,
   "versionNonce": 1587762608,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "the whole product is this paragraph, enforced in code",
   "originalText": "the whole product is this paragraph, enforced in code",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
