   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Why this is worth the trouble",
   "originalText": "Why this is worth the trouble",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0178",
   "type": "text",
   "x": 536,
   "y": 2482.0,
   "width": 386.88,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0175"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1550269626,
   "version": 1,
   "versionNonce": 1550269626,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "The usual architecture has a replay harness that resembles the\nlive loop and drifts from it quietly. Here the resemblance is\na test. Every claim on the site is about the policy that would\nactually trade, not about a simulator of it.",
   "originalText": "The usual architecture has a replay harness that resembles the\nlive loop and drifts from it quietly. Here the resemblance is\na test. Every claim on the site is about the policy that would\nactually trade, not about a simulator of it.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0180",
   "type": "rectangle",
   "x": 2270,
   "y": 1502.25,
   "width": 1420,
   "height": 100.5,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "#f1f3f5",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
