   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "What the replay costs to run",
   "originalText": "What the replay costs to run",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0540",
   "type": "text",
   "x": 2730,
   "y": 6033.0,
   "width": 1135.68,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0537"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1588181524,
   "version": 1,
   "versionNonce": 1588181524,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Measured on the 30-day WBNB/USDT tape: 1,839 events/s, 60 replays of ~125,700 events per agent, 4.6 hours serial for four policies. 86% of that is the sigma estimator recomputing its\nwindow. Parallelism was the right lever precisely because it changes no arithmetic \u2014 making sigma incremental would change summation order and therefore change bits, and T1 and L1\ncompare bits.",
   "originalText": "Measured on the 30-day WBNB/USDT tape: 1,839 events/s, 60 replays of ~125,700 events per agent, 4.6 hours serial for four policies. 86% of that is the sigma estimator recomputing its\nwindow. Parallelism was the right lever precisely because it changes no arithmetic \u2014 making sigma incremental would change summation order and therefore change bits, and T1 and L1\ncompare bits.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
