   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "WardenLive is pointed at a tape-backed source and its\ndecision sequence is compared byte for byte with\nReplayDriver's over the same tape. T1 proves the replay\ncould not cheat; L1 proves the thing that cheated is the\nthing that will trade.",
   "originalText": "WardenLive is pointed at a tape-backed source and its\ndecision sequence is compared byte for byte with\nReplayDriver's over the same tape. T1 proves the replay\ncould not cheat; L1 proves the thing that cheated is the\nthing that will trade.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
