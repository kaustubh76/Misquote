   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0063",
   "type": "text",
   "x": 2144.0,
   "y": 764.75,
   "width": 967.2,
   "height": 180.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
