   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "No in-range fraction and no LVR: a supplied position has no\nrange and cannot be picked off. Zeros in those columns would\nread as claims. Floors are the same \u2014 20 windows, 24h each \u2014 and\nunder 7 days it states the period instead of annualising.",
   "originalText": "No in-range fraction and no LVR: a supplied position has no\nrange and cannot be picked off. Zeros in those columns would\nread as claims. Floors are the same \u2014 20 windows, 24h each \u2014 and\nunder 7 days it states the period instead of annualising.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
