  },
  {
   "id": "mq0181",
   "type": "text",
   "x": 2284,
   "y": 1514.25,
   "width": 163.8,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
