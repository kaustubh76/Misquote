  {
   "id": "mq0408",
   "type": "text",
   "x": 2112,
   "y": 4501.875,
   "width": 524.16,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
