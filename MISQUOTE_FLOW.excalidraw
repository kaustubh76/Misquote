   "versionNonce": 1558857404,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "covered is not cursor",
   "originalText": "covered is not cursor",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0261",
   "type": "text",
   "x": 2544,
   "y": 3115.5,
   "width": 380.64,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0258"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1558962133,
   "version": 1,
   "versionNonce": 1558962133,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "A quiet 5,000-block window and one nobody fetched both hold\nzero swaps, and no query over the swap table can tell them\napart. So the ranges actually read are recorded separately. A\ndatabase predating that table reports no coverage, never full\ncoverage.",
   "originalText": "A quiet 5,000-block window and one nobody fetched both hold\nzero swaps, and no query over the swap table can tell them\napart. So the ranges actually read are recorded separately. A\ndatabase predating that table reports no coverage, never full\ncoverage.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0262",
   "type": "text",
   "x": 2544,
   "y": 3196.5,
   "width": 184.79999999999998,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0258"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1559066862,
   "version": 1,
   "versionNonce": 1559066862,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "unknown does not become pass",
   "originalText": "unknown does not become pass",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
