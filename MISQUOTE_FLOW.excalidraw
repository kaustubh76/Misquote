   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Every gate's value, every toxicity term, the centre, the half-width, r and delta* \u2014 written as one JSONL row per decision and again per outcome. That is why the tearsheet can say\nwhich gate held the position still and how often, rather than only that nothing happened. Outcomes are counted separately from decisions; folding them together is what once rendered\na single mint as three.",
   "originalText": "Every gate's value, every toxicity term, the centre, the half-width, r and delta* \u2014 written as one JSONL row per decision and again per outcome. That is why the tearsheet can say\nwhich gate held the position still and how often, rather than only that nothing happened. Outcomes are counted separately from decisions; folding them together is what once rendered\na single mint as three.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
