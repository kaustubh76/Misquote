   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Band 4's seam. A Policy function, a CATEGORIES entry, a run_agent call \u2014 and it inherits the engine, the tape, the cost model, the accountant, the quote\nmachinery, every refusal and the card. If a new agent needs a change below the policy, that is a finding about the engine and worth stopping for.",
   "originalText": "Band 4's seam. A Policy function, a CATEGORIES entry, a run_agent call \u2014 and it inherits the engine, the tape, the cost model, the accountant, the quote\nmachinery, every refusal and the card. If a new agent needs a change below the policy, that is a finding about the engine and worth stopping for.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
