   "lineHeight": 1.25
  },
  {
   "id": "mq0963",
   "type": "text",
   "x": 72,
   "y": 9298.25,
   "width": 929.76,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
