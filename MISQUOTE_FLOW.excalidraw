   "seed": 1578232269,
   "version": 1,
   "versionNonce": 1578232269,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Settle what the closing position earned and\nlost, open the new range, charge for the\nmove. A HOLD does nothing at all. A PULL\nsettles, records what it is left holding,\nand pays gas \u2014 leaving used to be free, an\nundercharge that fell on the agent and\nnever on the never-withdraw baseline it is\ncompared against.",
   "originalText": "Settle what the closing position earned and\nlost, open the new range, charge for the\nmove. A HOLD does nothing at all. A PULL\nsettles, records what it is left holding,\nand pays gas \u2014 leaving used to be free, an\nundercharge that fell on the agent and\nnever on the never-withdraw baseline it is\ncompared against.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
