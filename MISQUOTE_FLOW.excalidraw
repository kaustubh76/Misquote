   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "A1 caps a replayed position at 1% of the pool. The driver used to clamp and publish anyway, so a request for 1,000 WBNB was quoted on the 3.4 it\nactually deployed. Refusing is the quote A1 promises \u2014 P-14.",
   "originalText": "A1 caps a replayed position at 1% of the pool. The driver used to clamp and publish anyway, so a request for 1,000 WBNB was quoted on the 3.4 it\nactually deployed. Refusing is the quote A1 promises \u2014 P-14.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
