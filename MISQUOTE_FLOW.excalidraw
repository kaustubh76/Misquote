   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "chain/source.py :: TapeChainSource \u00b7 chain/live_source.py :: LiveChainSource",
   "originalText": "chain/source.py :: TapeChainSource \u00b7 chain/live_source.py :: LiveChainSource",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0103",
   "type": "text",
   "x": 494,
   "y": 1558.75,
   "width": 773.76,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0099"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1542414951,
   "version": 1,
   "versionNonce": 1542414951,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "One interface, two implementations, and the agent cannot tell them apart. **TapeChainSource** serves recorded history \u2014\nwhich is the only reason test L1 can exist. **LiveChainSource** reads a node, and runs two clocks deliberately: the decision\nclock ticks at delta_s = 5s, the poll clock is however often a free endpoint will answer. Between polls it returns nothing\nrather than pretending to be fresh.",
   "originalText": "One interface, two implementations, and the agent cannot tell them apart. **TapeChainSource** serves recorded history \u2014\nwhich is the only reason test L1 can exist. **LiveChainSource** reads a node, and runs two clocks deliberately: the decision\nclock ticks at delta_s = 5s, the poll clock is however often a free endpoint will answer. Between polls it returns nothing\nrather than pretending to be fresh.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0104",
   "type": "text",
   "x": 494,
   "y": 1624.75,
   "width": 389.4,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#2f9e44",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0099"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1542519680,
   "version": 1,
   "versionNonce": 1542519680,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "deviation D-9: m consecutive samples spans m x poll_seconds",
   "originalText": "deviation D-9: m consecutive samples spans m x poll_seconds",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
