   "text": "Backtesting \u2014 and its ways of lying",
   "originalText": "Backtesting \u2014 and its ways of lying",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0067",
   "type": "text",
   "x": 3180.0,
   "y": 743.0,
   "width": 283.8,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0064"
   ],
   "frameId": null,
