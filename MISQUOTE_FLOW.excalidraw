   "link": null,
   "locked": false,
   "text": "assumptions runs last because its cited_by is built by globbing every other artifact in the output directory, so an emitter running after it is invisible\nto it. Listed earlier it only looked right because the previous run's files were still on disk. status runs last of all and publishes the gate's verdict\nwithout enforcing it \u2014 make go-no-go is the one that enforces, and its exit code has to keep meaning something.",
   "originalText": "assumptions runs last because its cited_by is built by globbing every other artifact in the output directory, so an emitter running after it is invisible\nto it. Listed earlier it only looked right because the previous run's files were still on disk. status runs last of all and publishes the gate's verdict\nwithout enforcing it \u2014 make go-no-go is the one that enforces, and its exit code has to keep meaning something.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
