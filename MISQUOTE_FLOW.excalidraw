   "text": "The rule the whole repo is built on",
   "originalText": "The rule the whole repo is built on",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq1011",
   "type": "text",
   "x": 4180,
   "y": 9520.0,
   "width": 948.48,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq1008"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1637508883,
   "version": 1,
   "versionNonce": 1637508883,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Every displayed number must trace to a chain query or to an entry in the published assumption sheet. If it cannot, it does not render. Everything in the\neight bands above is machinery for keeping that sentence true under pressure.",
   "originalText": "Every displayed number must trace to a chain query or to an entry in the published assumption sheet. If it cannot, it does not render. Everything in the\neight bands above is machinery for keeping that sentence true under pressure.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq1016",
   "type": "text",
   "x": 234.8,
