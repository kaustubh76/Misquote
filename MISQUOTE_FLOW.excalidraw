   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "indexer/schema.sql",
   "originalText": "indexer/schema.sql",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0257",
   "type": "text",
   "x": 2544,
   "y": 2853.25,
   "width": 386.88,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0253"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1558543217,
   "version": 1,
   "versionNonce": 1558543217,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "Every uint256 is TEXT: SQLite's INTEGER is signed 64-bit and\nwould truncate sqrtPriceX96 and liquidity silently. Every\nevent table is keyed on (tx, log_index). Amounts are stored\ngross of the fee, because deriving net here would make the fee\nunrecoverable \u2014 P-2.",
   "originalText": "Every uint256 is TEXT: SQLite's INTEGER is signed 64-bit and\nwould truncate sqrtPriceX96 and liquidity silently. Every\nevent table is keyed on (tx, log_index). Amounts are stored\ngross of the fee, because deriving net here would make the fee\nunrecoverable \u2014 P-2.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0259",
   "type": "rectangle",
   "x": 2530,
   "y": 3076.75,
   "width": 420,
   "height": 145.5,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "#fff5f5",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0258"
   ],
   "frameId": null,
   "roundness": {
    "type": 3
   },
   "seed": 1558752675,
   "version": 1,
   "versionNonce": 1558752675,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false
  },
  {
   "id": "mq0260",
   "type": "text",
   "x": 2544,
   "y": 3088.75,
   "width": 163.8,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
