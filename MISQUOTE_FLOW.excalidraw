   "text": "THE SEAM \u00b7 four policies, one engine",
   "originalText": "THE SEAM \u00b7 four policies, one engine",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0348",
   "type": "text",
   "x": 1706,
   "y": 3840.375,
   "width": 804.96,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0345"
   ],
