   "versionNonce": 1549850710,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "the guarantee is structural, not reviewed",
   "originalText": "the guarantee is structural, not reviewed",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
