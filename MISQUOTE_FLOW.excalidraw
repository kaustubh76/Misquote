   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "It drew WardenLive -> WardenLoop -> ChainExecutor, when the loop calls the agent and the agent calls the executor. It drew the tape reaching the engine, which nothing does. And it drew ChainExecutor in the same style as the\nwired components, which is the failure this project is named after \u2014 a plausible arrow looks exactly like a correct one.",
   "originalText": "It drew WardenLive -> WardenLoop -> ChainExecutor, when the loop calls the agent and the agent calls the executor. It drew the tape reaching the engine, which nothing does. And it drew ChainExecutor in the same style as the\nwired components, which is the failure this project is named after \u2014 a plausible arrow looks exactly like a correct one.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
