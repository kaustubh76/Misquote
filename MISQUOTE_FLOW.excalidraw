   "link": null,
   "locked": false,
   "text": "A make target named in backticks anywhere in the repo must exist \u2014 this sentence originally failed that check by quoting one. A file named in a comment\nmust exist. Every assumption cited by any artifact must resolve in the published sheet. The counts in the judges' document are re-derived from pytest's own\ncollector. Each of these was a real defect before it was a test.",
   "originalText": "A make target named in backticks anywhere in the repo must exist \u2014 this sentence originally failed that check by quoting one. A file named in a comment\nmust exist. Every assumption cited by any artifact must resolve in the published sheet. The counts in the judges' document are re-derived from pytest's own\ncollector. Each of these was a real defect before it was a test.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
