   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "A liquidity position earns fees while price sits inside its range and loses to arbitrage whenever price moves. An agent that manages the range is betting the first exceeds the second, net of what moving costs. Everything on this\ncanvas is machinery for measuring that bet honestly on history nobody can retroactively choose.",
   "originalText": "A liquidity position earns fees while price sits inside its range and loses to arbitrage whenever price moves. An agent that manages the range is betting the first exceeds the second, net of what moving costs. Everything on this\ncanvas is machinery for measuring that bet honestly on history nobody can retroactively choose.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
