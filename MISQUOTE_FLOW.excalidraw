   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "What layer 2 may not do",
   "originalText": "What layer 2 may not do",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0173",
   "type": "text",
   "x": 72,
   "y": 2482.0,
   "width": 380.64,
   "height": 75.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0170"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1549745981,
   "version": 1,
   "versionNonce": 1549745981,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "It cannot read a clock, a socket or a database, so it cannot\nread the future. Reading market state is the one capability\nthat genuinely differs between live and replay, so the driver\nsupplies it as a MarketState argument and it lives in exactly\none place.",
   "originalText": "It cannot read a clock, a socket or a database, so it cannot\nread the future. Reading market state is the one capability\nthat genuinely differs between live and replay, so the driver\nsupplies it as a MarketState argument and it lives in exactly\none place.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0174",
   "type": "text",
   "x": 72,
   "y": 2563.0,
   "width": 270.59999999999997,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#e03131",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0170"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1549850710,
