  {
   "id": "mq0145",
   "type": "text",
   "x": 914,
   "y": 2245.5,
   "width": 767.52,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
