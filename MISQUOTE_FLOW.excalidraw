   "link": null,
   "locked": false,
   "text": "Where a change lands",
   "originalText": "Where a change lands",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0187",
   "type": "text",
   "x": 2284,
   "y": 1791.0,
   "width": 1354.0800000000002,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0184"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1551212187,
   "version": 1,
   "versionNonce": 1551212187,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "New strategy -> a Policy function, band 4. New market signal -> an estimator plus one Observation field, band 4. New cost -> CostModel and the assumption sheet, band 5. New published number -> an emitter, a TypeScript\ninterface and a contract test, bands 7 and 8. New chain read -> chain/ or indexer/, band 3 \u2014 never core/.",
   "originalText": "New strategy -> a Policy function, band 4. New market signal -> an estimator plus one Observation field, band 4. New cost -> CostModel and the assumption sheet, band 5. New published number -> an emitter, a TypeScript\ninterface and a contract test, bands 7 and 8. New chain read -> chain/ or indexer/, band 3 \u2014 never core/.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0188",
   "type": "text",
   "x": 2284,
   "y": 1827.0,
   "width": 448.8,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#495057",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0184"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1551316916,
   "version": 1,
   "versionNonce": 1551316916,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "if the change wants a clock inside a pure layer, the design is wrong",
   "originalText": "if the change wants a clock inside a pure layer, the design is wrong",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
