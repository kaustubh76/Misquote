   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "A note on notation that already cost a bug",
   "originalText": "A note on notation that already cost a bug",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0359",
   "type": "text",
   "x": 4004,
   "y": 3497.875,
   "width": 1129.44,
   "height": 30.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0356"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1569225575,
   "version": 1,
   "versionNonce": 1569225575,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "kappa here is the Avellaneda-Stoikov order-arrival parameter: fill intensity decays as exp(-kappa\u00b7delta). PolyLambda, which this was re-derived from, calls that k and uses kappa for\nan unrelated jump premium. Ported code carrying the other meaning is matrix item D-3.",
   "originalText": "kappa here is the Avellaneda-Stoikov order-arrival parameter: fill intensity decays as exp(-kappa\u00b7delta). PolyLambda, which this was re-derived from, calls that k and uses kappa for\nan unrelated jump premium. Ported code carrying the other meaning is matrix item D-3.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
