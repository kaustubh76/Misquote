   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0058",
   "type": "text",
   "x": 1108.0,
   "y": 764.75,
   "width": 960.96,
   "height": 210.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
