  {
   "id": "mq0445",
   "type": "text",
   "x": 414,
   "y": 5223.75,
   "width": 268.32,
   "height": 120.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
