   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "core/policy.py",
   "originalText": "core/policy.py",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0355",
   "type": "text",
   "x": 2804,
   "y": 3515.625,
   "width": 1141.92,
   "height": 60.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0351"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1568806659,
   "version": 1,
   "versionNonce": 1568806659,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "A concentrated position behaves like a pair of limit orders: reservation price maps to range centre, optimal half-spread to half-width, inventory penalty to the recentre trigger,\nadverse selection to LVR, quote pull to range withdrawal. It is a mapping that motivates the design and produces sane ranges \u2014 not an isomorphism. Uniswap's own docs say range orders\napproximate limit orders, there is no queue and no declining a fill, and equation (2) prices no adverse selection at all. Recorded as P-5 and A9, which is why sections 3.4 and 4 exist\nat all.",
   "originalText": "A concentrated position behaves like a pair of limit orders: reservation price maps to range centre, optimal half-spread to half-width, inventory penalty to the recentre trigger,\nadverse selection to LVR, quote pull to range withdrawal. It is a mapping that motivates the design and produces sane ranges \u2014 not an isomorphism. Uniswap's own docs say range orders\napproximate limit orders, there is no queue and no declining a fill, and equation (2) prices no adverse selection at all. Recorded as P-5 and A9, which is why sections 3.4 and 4 exist\nat all.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0357",
