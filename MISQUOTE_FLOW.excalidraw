  },
  {
   "id": "mq0860",
   "type": "text",
   "x": 3176,
   "y": 8174.0,
   "width": 967.2,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0856"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1621694804,
   "version": 1,
   "versionNonce": 1621694804,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
   "text": "The weakness to avoid is three tasks that are one task relabelled.\nEarn \u2014 baseline: mint once at the same width and never touch it. Isolates the recentring decision.\nProtect \u2014 baseline: the same agent with its withdrawal disabled. An ablation \u2014 the same program with one behaviour switched off \u2014 so the only difference is\nwhether it leaves when flow turns one-way.\nChoose \u2014 baseline: pick the deepest pool. Two real venues, one fee tier apart, each with its own PoolMeta because their protocol fees differ \u2014 sharing one\nwould credit the second pool's LPs with a share they do not get. What an LP actually does, and the task exists to test whether deeper is safer.",
   "originalText": "The weakness to avoid is three tasks that are one task relabelled.\nEarn \u2014 baseline: mint once at the same width and never touch it. Isolates the recentring decision.\nProtect \u2014 baseline: the same agent with its withdrawal disabled. An ablation \u2014 the same program with one behaviour switched off \u2014 so the only difference is\nwhether it leaves when flow turns one-way.\nChoose \u2014 baseline: pick the deepest pool. Two real venues, one fee tier apart, each with its own PoolMeta because their protocol fees differ \u2014 sharing one\nwould credit the second pool's LPs with a share they do not get. What an LP actually does, and the task exists to test whether deeper is safer.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "id": "mq0861",
   "type": "text",
   "x": 3176,
   "y": 8270.0,
   "width": 594.0,
   "height": 13.75,
   "angle": 0,
   "strokeColor": "#9c36b5",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "mq0856"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1621799533,
   "version": 1,
   "versionNonce": 1621799533,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1786531955200,
   "link": null,
   "locked": false,
